        }
      ],
      "references": [
        "uagf:requirement/UGR-20"
      ]
    },
    {
      "@id": "uagf:requirement/UGR-25",
      "@type": "Requirement",
      "label": {
        "@value": "AI System Disclosure",
        "@language": "en"
      },
      "statement": "Users must be informed when they are interacting with an AI system, including the nature and purpose of the system, in a clear and understandable manner.",
      "intent": "Ensure users are aware they are interacting with AI and can make informed decisions about their engagement.",
      "applicability": "All organizations with user-facing AI systems",
      "priority": "high",
      "version": "1.0",
      "status": "proposed",
      "requirement_type": [
        "legal",
        "principle"
      ],
      "lifecycle_stages": [
        "operation"
      ],
      "risk_categories": [
        "transparency",
        "human-rights"
      ],
      "belongsTo": "uagf:domain/DOM-TRANSPARENCY",
      "derivesFrom": [
        {
          "@id": "uagf:externalreference/REF-EUAIA",
          "locator": "Article 50",
          "verification": "pending"
        },
        {
          "@id": "uagf:externalreference/REF-OECD-AIP",
          "locator": null,
          "verification": "pending"
        },
        {
          "@id": "uagf:externalreference/REF-UNESCO-RECOMMENDATION-ON",
          "locator": null,
          "verification": "pending"
        }
      ],
      "references": [
        "uagf:requirement/UGR-26",
        "uagf:requirement/UGR-27"
      ]
    },
    {
      "@id": "uagf:requirement/UGR-26",
      "@type": "Requirement",
      "label": {
        "@value": "Synthetic Content Labeling",
        "@language": "en"
      },
      "statement": "AI-generated synthetic content (including text, images, audio, and video) must be clearly labeled as AI-generated or AI-manipulated in a machine-readable and human-readable format.",
      "intent": "Prevent deception by ensuring users can identify AI-generated content.",
      "applicability": "Organizations that generate synthetic content using AI",
      "priority": "high",
      "version": "1.0",
      "status": "proposed",
      "requirement_type": [
        "legal",
        "standard"
      ],
      "lifecycle_stages": [
        "operation"
      ],
      "risk_categories": [
        "transparency",
        "disinformation"
      ],
      "belongsTo": "uagf:domain/DOM-TRANSPARENCY",
      "derivesFrom": [
        {
          "@id": "uagf:externalreference/REF-EUAIA",
          "locator": "Article 50",
          "verification": "pending"
        },
        {
          "@id": "uagf:externalreference/REF-C2PA",
          "locator": null,
          "verification": "pending"
        }
      ],
      "references": [
        "uagf:requirement/UGR-25",
        "uagf:requirement/UGR-27"
      ]
    },
    {
      "@id": "uagf:requirement/UGR-27",
      "@type": "Requirement",
      "label": {
        "@value": "Deepfake Disclosure",
        "@language": "en"
      },
      "statement": "Deepfake content (AI-generated or manipulated image, audio, or video that resembles real persons or events) must be clearly disclosed as artificially generated or manipulated.",
      "intent": "Prevent misinformation and deception through realistic synthetic media.",
      "applicability": "Organizations that generate or distribute deepfake content",
      "priority": "high",
      "version": "1.0",
      "status": "proposed",
      "requirement_type": [
        "legal"
      ],
      "lifecycle_stages": [
        "operation"
      ],
      "risk_categories": [
        "transparency",
        "disinformation",
        "human-rights"
      ],
      "belongsTo": "uagf:domain/DOM-TRANSPARENCY",
      "derivesFrom": [
        {
          "@id": "uagf:externalreference/REF-EUAIA",
          "locator": "Article 50(4)",
          "verification": "pending"
        },
        {
          "@id": "uagf:externalreference/REF-EUAIA",
          "locator": "Article 3(66)",
          "verification": "pending"
        }
      ],
      "references": [
        "uagf:requirement/UGR-25",
        "uagf:requirement/UGR-26"
      ]
    },
    {
      "@id": "uagf:requirement/UGR-3",
      "@type": "Requirement",
      "label": {
        "@value": "Top Management Commitment",
        "@language": "en"
      },
      "statement": "Top management must demonstrate commitment to AI governance by approving the AI policy, allocating resources, and regularly reviewing AI governance performance.",
      "intent": "Ensure AI governance has executive-level support and resources to be effective.",
      "applicability": "All organizations that develop, deploy, or operate AI systems",
      "priority": "high",
      "version": "1.0",
      "status": "proposed",
      "requirement_type": [
        "standard"
      ],
      "lifecycle_stages": [
        "all-stages"
      ],
      "risk_categories": [
        "governance"
      ],
      "belongsTo": "uagf:domain/DOM-GOV",
      "derivesFrom": [
        {
          "@id": "uagf:externalreference/REF-ISO42001",
          "locator": "Clause 5.1",
          "verification": "pending"
        },
        {
          "@id": "uagf:externalreference/REF-EUAIA",
          "locator": "Article 26",
          "verification": "pending"
        }
      ],
      "references": [
        "uagf:requirement/UGR-1",
        "uagf:requirement/UGR-2"
      ]
    },
    {
      "@id": "uagf:requirement/UGR-35",
      "@type": "Requirement",
      "label": {
        "@value": "AI System Logging",
        "@language": "en"
      },
      "statement": "AI systems must log all material decisions, actions, and events, including inputs, outputs, decision rationale, and human interventions, in a format suitable for audit and review.",
      "intent": "Enable audit, investigation, and continuous improvement through complete records of AI system behavior.",
      "applicability": "All organizations with AI systems",
      "priority": "critical",
      "version": "1.0",
      "status": "proposed",
      "requirement_type": [
        "legal",
        "standard"
      ],
      "lifecycle_stages": [
        "all-stages"
      ],
      "risk_categories": [
        "auditability",
        "accountability"
      ],
      "belongsTo": "uagf:domain/DOM-AUDITABILITY",
      "derivesFrom": [
        {
          "@id": "uagf:externalreference/REF-EUAIA",
          "locator": "Article 12",
          "verification": "pending"
        },
        {
          "@id": "uagf:externalreference/REF-ISO42001",
          "locator": "Clause 8",
          "verification": "pending"
        },
        {
          "@id": "uagf:externalreference/REF-NIST-AIRMF",
          "locator": null,
          "verification": "pending"
        }
      ],
      "references": [
        "uagf:requirement/UGR-36",
        "uagf:requirement/UGR-37",
        "uagf:requirement/UGR-45"
      ]
    },
    {
      "@id": "uagf:requirement/UGR-36",
      "@type": "Requirement",
      "label": {
        "@value": "Audit Trail Retention",
        "@language": "en"
      },
      "statement": "The organization must retain audit trails for AI systems for a defined retention period (minimum 5 years for high-risk systems) in a tamper-evident format that supports retrieval and replay.",
      "intent": "Ensure evidence is available for audits, investigations, and regulatory reviews.",
      "applicability": "All organizations with AI systems",
      "priority": "high",
      "version": "1.0",
      "status": "proposed",
      "requirement_type": [
        "legal",
        "standard"
      ],
      "lifecycle_stages": [
        "all-stages"
      ],
      "risk_categories": [
        "auditability",
        "compliance"
      ],
      "belongsTo": "uagf:domain/DOM-AUDITABILITY",
      "derivesFrom": [
