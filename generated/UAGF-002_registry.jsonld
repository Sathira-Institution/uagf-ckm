    {
      "@id": "uagf:requirement/UGR-1",
      "@type": "Requirement",
      "label": {
        "@value": "AI Governance Ownership",
        "@language": "en"
      },
      "statement": "The organization must designate a person or function with overall accountability for AI governance, including policy development, risk oversight, and compliance monitoring.",
      "intent": "Ensure clear ownership and accountability for AI governance across the organization.",
      "applicability": "All organizations that develop, deploy, or operate AI systems",
      "priority": "high",
      "version": "1.0",
      "status": "proposed",
      "requirement_type": [
        "standard",
        "legal"
      ],
      "lifecycle_stages": [
        "all-stages"
      ],
      "risk_categories": [
        "governance"
      ],
      "belongsTo": "uagf:domain/DOM-GOV",
      "derivesFrom": [
        {
          "@id": "uagf:externalreference/REF-ISO42001",
          "locator": "Clause 5.3",
          "verification": "pending"
        },
        {
          "@id": "uagf:externalreference/REF-EUAIA",
          "locator": "Article 26",
          "verification": "pending"
        },
        {
          "@id": "uagf:externalreference/REF-TH-PDPA",
          "locator": "Section 41",
          "verification": "pending"
        }
      ],
      "references": [
        "uagf:requirement/UGR-2",
        "uagf:requirement/UGR-3",
        "uagf:requirement/UGR-15"
      ]
    },
    {
      "@id": "uagf:requirement/UGR-15",
      "@type": "Requirement",
      "label": {
        "@value": "Human Oversight for High-Risk AI",
        "@language": "en"
      },
      "statement": "High-risk AI systems must be designed and operated in a way that enables effective human oversight, including the ability for humans to intervene, override, or stop the system when necessary.",
      "intent": "Ensure human judgment remains the final authority for consequential AI decisions, preventing full automation of decisions with significant impact.",
      "applicability": "Organizations deploying high-risk AI systems",
      "priority": "critical",
      "version": "1.0",
      "status": "proposed",
      "requirement_type": [
        "legal",
        "standard"
      ],
      "lifecycle_stages": [
        "design",
        "development",
        "operation"
      ],
      "risk_categories": [
        "human-rights",
        "safety",
        "accountability"
      ],
      "belongsTo": "uagf:domain/DOM-HUMAN",
      "derivesFrom": [
        {
          "@id": "uagf:externalreference/REF-EUAIA",
          "locator": "Article 14",
          "verification": "pending"
        },
        {
          "@id": "uagf:externalreference/REF-ISO42001",
          "locator": "Clause 8",
          "verification": "pending"
        },
        {
          "@id": "uagf:externalreference/REF-OECD-AIP",
          "locator": null,
          "verification": "pending"
        }
      ],
      "references": [
        "uagf:requirement/UGR-4",
        "uagf:requirement/UGR-16",
        "uagf:requirement/UGR-17",
        "uagf:requirement/UGR-45"
      ]
    },
    {
      "@id": "uagf:requirement/UGR-16",
      "@type": "Requirement",
      "label": {
        "@value": "Human Approval Workflow",
        "@language": "en"
      },
      "statement": "The organization must establish documented approval workflows for AI system decisions, specifying who must approve which types of decisions, under what conditions, and within what timeframe.",
      "intent": "Ensure decisions of consequence are routed through a documented, accountable approval process before execution.",
      "applicability": "All organizations with AI systems that make consequential decisions",
      "priority": "high",
      "version": "1.0",
      "status": "proposed",
      "requirement_type": [
        "standard"
      ],
      "lifecycle_stages": [
        "design",
        "development",
        "operation"
      ],
      "risk_categories": [
        "accountability",
        "governance"
      ],
      "belongsTo": "uagf:domain/DOM-HUMAN",
      "derivesFrom": [
        {
          "@id": "uagf:externalreference/REF-ISO42001",
          "locator": "Clause 8",
          "verification": "pending"
        },
        {
          "@id": "uagf:externalreference/REF-EUAIA",
          "locator": "Article 14",
          "verification": "pending"
        }
      ],
      "references": [
        "uagf:requirement/UGR-15",
        "uagf:requirement/UGR-17",
        "uagf:requirement/UGR-45"
      ]
    },
    {
      "@id": "uagf:requirement/UGR-17",
      "@type": "Requirement",
      "label": {
        "@value": "Human Intervention Mechanism",
        "@language": "en"
      },
      "statement": "The organization must implement mechanisms that allow authorized human operators to intervene, override, or halt AI system actions in real time when necessary to prevent harm or correct erroneous behavior.",
      "intent": "Ensure humans can stop or correct AI actions when necessary.",
      "applicability": "Organizations deploying high-risk AI systems",
      "priority": "critical",
      "version": "1.0",
      "status": "proposed",
      "requirement_type": [
        "legal",
        "standard"
      ],
      "lifecycle_stages": [
        "design",
        "development",
        "operation"
      ],
      "risk_categories": [
        "human-rights",
        "safety",
        "accountability"
      ],
      "belongsTo": "uagf:domain/DOM-HUMAN",
      "derivesFrom": [
        {
          "@id": "uagf:externalreference/REF-EUAIA",
          "locator": "Article 14",
          "verification": "pending"
        },
        {
          "@id": "uagf:externalreference/REF-ISO42001",
          "locator": "Clause 8",
          "verification": "pending"
        }
      ],
      "references": [
        "uagf:requirement/UGR-15",
        "uagf:requirement/UGR-45"
      ]
    },
    {
      "@id": "uagf:requirement/UGR-2",
      "@type": "Requirement",
      "label": {
        "@value": "AI Policy Framework",
        "@language": "en"
      },
      "statement": "The organization must establish, document, and maintain an AI policy that defines governance principles, risk tolerance, ethical commitments, and compliance requirements for AI systems.",
      "intent": "Provide a formal, documented foundation for AI governance that communicates organizational commitments and expectations.",
      "applicability": "All organizations that develop, deploy, or operate AI systems",
      "priority": "high",
      "version": "1.0",
      "status": "proposed",
      "requirement_type": [
        "standard"
      ],
      "lifecycle_stages": [
        "all-stages"
      ],
      "risk_categories": [
        "governance"
      ],
      "belongsTo": "uagf:domain/DOM-GOV",
      "derivesFrom": [
        {
          "@id": "uagf:externalreference/REF-ISO42001",
          "locator": "Clause 5.2",
          "verification": "pending"
        },
        {
          "@id": "uagf:externalreference/REF-EUAIA",
          "locator": "Article 26",
          "verification": "pending"
        },
        {
          "@id": "uagf:externalreference/REF-OECD-AIP",
          "locator": null,
          "verification": "pending"
        }
      ],
      "references": [
        "uagf:requirement/UGR-1",
        "uagf:requirement/UGR-4"
      ]
    },
    {
      "@id": "uagf:requirement/UGR-20",
      "@type": "Requirement",
      "label": {
        "@value": "Data Quality for AI Systems",
        "@language": "en"
      },
      "statement": "The organization must ensure that data used for training, validation, and operation of AI systems is of sufficient quality, including accuracy, completeness, relevance, and representativeness for the intended use.",
      "intent": "Prevent AI system errors and biases caused by poor quality data.",
      "applicability": "All organizations that develop or operate AI systems",
      "priority": "high",
      "version": "1.0",
      "status": "proposed",
      "requirement_type": [
        "legal",
        "standard"
      ],
      "lifecycle_stages": [
        "development",
        "operation"
      ],
      "risk_categories": [
        "fairness",
        "safety",
        "privacy"
      ],
      "belongsTo": "uagf:domain/DOM-DATA",
      "derivesFrom": [
        {
          "@id": "uagf:externalreference/REF-EUAIA",
          "locator": "Article 10",
          "verification": "pending"
        },
        {
          "@id": "uagf:externalreference/REF-ISO42001",
          "locator": "Annex A (Data Integrity)",
          "verification": "pending"
        },
        {
          "@id": "uagf:externalreference/REF-TH-PDPA",
          "locator": "Section 23",
          "verification": "pending"
        }
      ],
      "references": [
        "uagf:requirement/UGR-21",
        "uagf:requirement/UGR-22"
      ]
    },
    {
      "@id": "uagf:requirement/UGR-21",
      "@type": "Requirement",
      "label": {
        "@value": "Data Lineage and Provenance",
        "@language": "en"
      },
      "statement": "The organization must maintain data lineage records that track the origin, transformation, and flow of data used in AI systems from source to consumption, enabling traceability and auditability.",
      "intent": "Enable traceability of data used in AI systems for audit, compliance, and error investigation.",
      "applicability": "All organizations that develop or operate AI systems",
      "priority": "high",
      "version": "1.0",
      "status": "proposed",
      "requirement_type": [
        "legal",
        "standard"
      ],
      "lifecycle_stages": [
        "development",
        "operation"
      ],
      "risk_categories": [
        "privacy",
        "fairness",
        "auditability"
      ],
      "belongsTo": "uagf:domain/DOM-DATA",
      "derivesFrom": [
        {
          "@id": "uagf:externalreference/REF-EUAIA",
          "locator": "Article 10",
          "verification": "pending"
        },
        {
          "@id": "uagf:externalreference/REF-ISO42001",
          "locator": "Annex A (Data Integrity)",
          "verification": "pending"
        },
        {
          "@id": "uagf:externalreference/REF-NIST-AIRMF",
          "locator": null,
          "verification": "pending"
        }
      ],
      "references": [
        "uagf:requirement/UGR-20",
        "uagf:requirement/UGR-35",
        "uagf:requirement/UGR-36"
      ]
    },
    {
      "@id": "uagf:requirement/UGR-22",
      "@type": "Requirement",
      "label": {
        "@value": "Data Classification for AI Systems",
        "@language": "en"
      },
      "statement": "The organization must classify data used in AI systems according to sensitivity, regulatory requirements, and risk, and apply appropriate controls based on classification.",
      "intent": "Ensure appropriate protection for data based on sensitivity and regulatory requirements.",
      "applicability": "All organizations that process data through AI systems",
      "priority": "high",
      "version": "1.0",
      "status": "proposed",
      "requirement_type": [
        "legal",
        "standard"
      ],
      "lifecycle_stages": [
        "all-stages"
      ],
      "risk_categories": [
        "privacy",
        "security"
      ],
      "belongsTo": "uagf:domain/DOM-DATA",
      "derivesFrom": [
        {
          "@id": "uagf:externalreference/REF-TH-PDPA",
          "locator": "Section 23",
          "verification": "pending"
        },
        {
          "@id": "uagf:externalreference/REF-ISO42001",
          "locator": "Annex A (Privacy)",
          "verification": "pending"
        },
        {
          "@id": "uagf:externalreference/REF-NIST-AIRMF",
          "locator": null,
